# ── Database (PostgreSQL) ──
# Use Vercel Postgres, Supabase, Neon, or Railway
DATABASE_URL="postgresql://user:password@host:5432/challengeai?sslmode=require"

# AI supplier request limits, shared across instances via PostgreSQL audit reservations.
# Set AI_ENABLED=false to stop paid calls; local quest settings still work.
AI_ENABLED="true"
AI_GLOBAL_DAILY_CALL_LIMIT="1000"
AI_USER_DAILY_CALL_LIMIT="100"
AI_GLOBAL_MINUTE_CALL_LIMIT="100"
AI_USER_MINUTE_CALL_LIMIT="20"
AI_REQUEST_CALL_LIMIT="6"
AI_TEXT_TIMEOUT_MS="40000"
AI_VISION_TIMEOUT_MS="80000"
# These are request/output bounds, not USD or exact input-token spending caps.
# /api/ai/usage reports supplier token receipts; missing usage and billed USD stay unknown.

# ── NextAuth ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Google OAuth ──
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Anthropic AI ──
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# ══════════════════════════════════════════════
# ON-CHAIN USAGE TOKEN (optional — enables true tokenization)
# Without these, the app runs with off-chain credits in PostgreSQL.
# With these, USAGE is a real ERC-20 token on Base.
# ══════════════════════════════════════════════

# Network: "base-sepolia" (testnet) or "base" (mainnet)
X402_NETWORK="base-sepolia"

# RPC URL (get free at https://www.alchemy.com or https://www.infura.io)
RPC_URL="https://sepolia.base.org"

# Deployed contract addresses (after running forge deploy)
USAGE_TOKEN_ADDRESS=""
ESCROW_ADDRESS=""

# Server wallet private key — used to burn tokens + settle challenges
# This wallet must be set as an authorized burner/judge in the contracts
SERVER_PRIVATE_KEY=""

# USDC contract address on Base Sepolia
USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Private video/photo intake (default OFF; do not enable without private bucket QA)
# These are separate from the legacy public media store. Both flags must be
# explicitly assessed by the owner before production activation.
ENABLE_TRUSTED_EVIDENCE_UPLOADS="false"
TRUSTED_EVIDENCE_REQUIRED_FOR_MEDIA="false"
S3_TRUSTED_EVIDENCE_BUCKET=""
S3_TRUSTED_EVIDENCE_ENDPOINT=""
S3_TRUSTED_EVIDENCE_FORCE_PATH_STYLE="false"
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION also required.
# R2: AWS_REGION=auto; endpoint=https://<account-id>.r2.cloudflarestorage.com.
# Only grant read/write access to a PRIVATE bucket, never public CDN access.
